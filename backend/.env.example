# Application Environment (development, staging, production)
APP_ENV=development

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Path for external AI system
TRUSTSHIELD_AI_ROOT=D:\TrustShield\ai

# Configurable CORS origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# WebSocket & Audio Buffer Limits
MAX_WS_MESSAGE_BYTES=1048576
MAX_WS_TEXT_LENGTH=10000
MAX_AUDIO_CHUNK_BYTES=1048576
MAX_SESSION_AUDIO_BYTES=10485760

# Audio Normalization Parameters
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1
TARGET_SAMPLE_WIDTH=2
MAX_AUDIO_DURATION_SECONDS=300.0

# Whisper Model Configuration
WHISPER_MODEL_SIZE=tiny
